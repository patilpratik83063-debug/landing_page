# Copy these into Vercel Dashboard → Settings → Environment Variables
# (Production + Preview), and locally into .env.local (gitignored).
# NEVER commit real keys. If a live secret was ever pasted in chat/email,
# regenerate it: Razorpay Dashboard → Settings → API Keys → Regenerate.

RAZORPAY_KEY_ID=rzp_live_xxxx
RAZORPAY_KEY_SECRET=xxxx
